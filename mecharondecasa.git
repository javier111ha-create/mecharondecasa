    <div class="stat"><div class="stat-num">2018</div><div class="stat-label">Fundado en Santiago</div></div>
    <div class="stat"><div class="stat-num">+60</div><div class="stat-label">Tragos en carta</div></div>
    <div class="stat"><div class="stat-num">+80</div><div class="stat-label">Platos en menú</div></div>
    <div class="stat"><div class="stat-num">5★</div><div class="stat-label">Valoración clientes</div></div>
    <div class="stat"><div class="stat-num">HH</div><div class="stat-label">18:00 – 19:00</div></div>
  </div>
</div>

<!-- ═══ MENÚ / CARTA ═══ -->
<section id="carta" class="u-section" aria-label="Menú completo">
  <div class="u-container">
    <header class="menu-hero">
      <span class="u-tag">✦ Directo del PDF 2026 ✦</span>
      <h2 class="u-title">NUESTRA<em>Carta</em></h2>
      <div class="u-divider"></div>
      <p style="font-size:.82rem;color:var(--c-muted);margin-top:1rem;max-width:560px;margin-left:auto;margin-right:auto;line-height:1.7">Explora nuestro menú completo. Haz clic en cualquier producto para ver sus detalles, ingredientes y agregarlo al carrito.</p>
    </header>

    <!-- HH BANNER -->
    <div style="background:linear-gradient(135deg,#0d2318,#1B4332 50%,#0d2318);border:1px solid rgba(245,196,0,.18);border-radius:8px;padding:1.25rem 1.75rem;display:flex;align-items:center;justify-content:space-between;gap:1.25rem;max-width:960px;margin:0 auto 3rem;flex-wrap:wrap">
      <div style="display:flex;align-items:center;gap:1rem">
        <span style="font-size:2.2rem">⏰</span>
        <div>
          <div style="font-family:var(--font-d);font-size:1.5rem;color:var(--c-yellow);letter-spacing:.04em;line-height:1">HAPPY HOUR</div>
          <div style="font-size:.7rem;color:rgba(247,245,240,.7);letter-spacing:.08em;margin-top:.2rem">Lunes a Viernes · 18:00 a 19:00 · Precios especiales en tragos seleccionados</div>
        </div>
      </div>
      <button class="btn btn-yellow btn-sm" onclick="openResModal()">Reservar para HH</button>
    </div>

    <div class="menu-cards-grid">

      <!-- CARD COMIDAS -->
      <div class="menu-main-card mmc-food" id="cardComidas">
        <div class="mmc-header" onclick="toggleMenuCard('comidas')">
          <span class="mmc-emoji">🍔</span>
          <div class="mmc-info">
            <div class="mmc-title">COMIDAS</div>
            <div class="mmc-sub">Mechados · Churrascos · Burgers</div>
            <div class="mmc-count" id="foodCount">69 productos · 7 categorías</div>
          </div>
          <span class="mmc-arrow">›</span>
        </div>
        <div class="accordion-body" id="bodyComidas">
          <div class="accordion-inner">
            <!-- SEARCH -->
            <div class="menu-search-wrap">
              <span class="menu-search-icon">🔍</span>
              <input type="search" class="menu-search" placeholder="Buscar en Comidas…" oninput="searchMenu('food',this.value)" aria-label="Buscar comidas">
            </div>
            <!-- FILTERS -->
            <div class="filter-tabs" id="foodFilters" role="tablist">
              <button class="filter-tab active" onclick="filterCat('food','all',this)" role="tab">Todo</button>
              <button class="filter-tab" onclick="filterCat('food','sandwich',this)" role="tab">Sándwiches</button>
              <button class="filter-tab" onclick="filterCat('food','churrasco',this)" role="tab">Churrasco</button>
              <button class="filter-tab" onclick="filterCat('food','burger',this)" role="tab">Hamburguesas</button>
              <button class="filter-tab" onclick="filterCat('food','entrada',this)" role="tab">Entradas</button>
              <button class="filter-tab" onclick="filterCat('food','tabla',this)" role="tab">Tablas</button>
              <button class="filter-tab" onclick="filterCat('food','papas',this)" role="tab">Papas Fritas</button>
              <button class="filter-tab" onclick="filterCat('food','postre',this)" role="tab">Postres</button>
            </div>
            <!-- LIST -->
            <div id="foodList"></div>
          </div>
        </div>
      </div>

      <!-- CARD COCTELERÍA -->
      <div class="menu-main-card mmc-cocktail" id="cardCocteleria">
        <div class="mmc-header" onclick="toggleMenuCard('cocteleria')">
          <span class="mmc-emoji">🍹</span>
          <div class="mmc-info">
            <div class="mmc-title">COCTELERÍA</div>
            <div class="mmc-sub">Tragos · Cocteles de Autor · Cervezas</div>
            <div class="mmc-count" id="coctCount">80+ productos · 12 categorías</div>
          </div>
          <span class="mmc-arrow">›</span>
        </div>
        <div class="accordion-body" id="bodyCocteleria">
          <div class="accordion-inner">
            <div class="menu-search-wrap">
              <span class="menu-search-icon">🔍</span>
              <input type="search" class="menu-search" placeholder="Buscar en Coctelería…" oninput="searchMenu('coct',this.value)" aria-label="Buscar coctelería">
            </div>
            <div class="filter-tabs" id="coctFilters" role="tablist">
              <button class="filter-tab active" onclick="filterCat('coct','all',this)" role="tab">Todo</button>
              <button class="filter-tab" onclick="filterCat('coct','autor',this)" role="tab">De Autor ✦</button>
              <button class="filter-tab" onclick="filterCat('coct','ron',this)" role="tab">Ron</button>
              <button class="filter-tab" onclick="filterCat('coct','vodka',this)" role="tab">Vodka</button>
              <button class="filter-tab" onclick="filterCat('coct','cachaza',this)" role="tab">Cachaza</button>
              <button class="filter-tab" onclick="filterCat('coct','tequila',this)" role="tab">Tequila</button>
              <button class="filter-tab" onclick="filterCat('coct','pisco',this)" role="tab">Pisco</button>
              <button class="filter-tab" onclick="filterCat('coct','gin',this)" role="tab">Gin</button>
              <button class="filter-tab" onclick="filterCat('coct','whisky',this)" role="tab">Whisky</button>
              <button class="filter-tab" onclick="filterCat('coct','spritz',this)" role="tab">Spritz</button>
              <button class="filter-tab" onclick="filterCat('coct','mocktail',this)" role="tab">Sin Alcohol</button>
              <button class="filter-tab" onclick="filterCat('coct','destilado',this)" role="tab">Destilados</button>
              <button class="filter-tab" onclick="filterCat('coct','cerveza',this)" role="tab">Cervezas</button>
              <button class="filter-tab" onclick="filterCat('coct','shot',this)" role="tab">Shots</button>
              <button class="filter-tab" onclick="filterCat('coct','bebestible',this)" role="tab">Bebestibles</button>
            </div>
            <div id="coctList"></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══ PROMOCIONES ═══ -->
<section id="promociones" class="u-section" aria-label="Promociones semanales">

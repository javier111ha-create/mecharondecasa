  </div>
  <div class="hero-scroll" aria-hidden="true">
    <span class="hero-scroll-text">Descubrir</span>
    <div class="hero-scroll-line"></div>
  </div>
</section>

<!-- ═══ STATS BAR ═══ -->
<div class="stats-bar" role="complementary" aria-label="Estadísticas">

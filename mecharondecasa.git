      <a href="#delivery" onclick="closeMob()">🛵 Delivery <span>→</span></a>
      <a href="#reservas" onclick="closeMob()">📅 Reservar Mesa <span>→</span></a>
      <a href="#nosotros" onclick="closeMob()">⭐ Nuestra Historia <span>→</span></a>
      <a href="#contacto" onclick="closeMob()">📍 Contacto <span>→</span></a>
    </nav>
    <div class="mob-nav-ctas">
      <button class="btn btn-yellow" onclick="openResModal();closeMob()">Reservar Mesa</button>
      <a href="https://wa.me/56988252884" target="_blank" rel="noopener" class="btn btn-wa">💬 WhatsApp</a>
    </div>
  </div>
</div>

<!-- ═══ HERO ═══ -->
<section id="hero" aria-label="Bienvenida">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-dots" aria-hidden="true"></div>
  <div class="hero-content">
    <div class="hero-eyebrow">✦ Restobar · Santiago de Chile · Est. 2018 ✦</div>
    <h1 class="hero-title">
      <span>MECHA</span><span class="accent">RON</span><br>
      <span class="stroke">DE</span><br>
      <span>CASA</span>
    </h1>
    <p class="hero-tagline">Sándwiches Mechados · Hamburguesas Artesanales · Coctelería de Autor</p>
    <div class="hero-ctas">
      <button class="btn btn-yellow btn-lg" onclick="openResModal()">📅 Reservar Mesa</button>
      <a href="#carta" class="btn btn-outline btn-lg">🍔 Ver Menú</a>
      <a href="#delivery" class="btn btn-red btn-lg">🛵 Pedir Delivery</a>

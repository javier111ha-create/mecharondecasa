/* ── PROMOTIONS DATA ── */
const PROMOTIONS = [
  {day:2,dayName:'MARTES',icon:'🍷',product:'Ramazzotti & Aperol Spritz',desc:'El amargor elegante del Ramazzotti con la frescura cítrica del Aperol Spritz. La dupla perfecta para empezar la semana.',price:'$7.000',priceSub:'2 tragos · Precio especial',headBg:'var(--c-yellow)',headColor:'var(--c-black)'},
  {day:3,dayName:'MIÉRCOLES',icon:'🥃',product:'Pisco Alto del Carmen Combinado',desc:'El pisco chileno más premiado en combinado doble. Fresco, balanceado y con carácter del norte de Chile.',price:'$7.000',priceSub:'2 tragos · Precio especial',headBg:'var(--c-green)',headColor:'var(--c-yellow)'},
  {day:4,dayName:'JUEVES',icon:'🍺',product:'Cerveza Kross Artesanal',desc:'La cerveza artesanal chilena más distinguida. Elige Pils seca y balanceada o Golden suave y refrescante.',price:'$7.000',priceSub:'Normal 2x · Pils o Golden',extra:'$8.000',extraSub:'Chelada 2x · Con limón y sal',headBg:'#B8791A',headColor:'var(--c-white)'},
  {day:5,dayName:'VIERNES',icon:'🍹',product:'30% Desc. Coctelería de Autor',desc:'Todos los cocteles de autor con 30% de descuento. Mango Coco Loco, Monster Mule, No Te Moai Tiki, Manzalvia y más.',price:'30% OFF',priceSub:'Toda la coctelería de autor',headBg:'var(--c-red)',headColor:'var(--c-white)'},
  {day:6,dayName:'SÁBADO',icon:'🌿',product:'3 Mojitos',desc:'Tres mojitos por el precio de un momento inolvidable. Tradicional o con sabores: Frambuesa, Mango o Maracuyá.',price:'$10.000',priceSub:'3 mojitos · Tradicional o sabores',headBg:'linear-gradient(135deg,var(--c-green),#0b2215)',headColor:'var(--c-yellow)'}
];

/* ── FORMAT ── */
const fp = n => '$' + Number(n).toLocaleString('es-CL');
const today = new Date().getDay();

/* ── PROMO STRIP ── */
(function initPromoStrip(){
  const msgs = {
    2:`⚡ HOY MARTES: <strong>Ramazzotti &amp; Aperol Spritz 2×$7.000</strong> · Solo con consumo de alimentos`,
    3:`⚡ HOY MIÉRCOLES: <strong>Pisco Alto del Carmen Combinado 2×$7.000</strong> · Solo con consumo de alimentos`,
    4:`⚡ HOY JUEVES: <strong>Kross Normal 2×$7.000 · Kross Chelada 2×$8.000</strong> · Solo con consumo de alimentos`,
    5:`⚡ HOY VIERNES: <strong>30% OFF en toda la Coctelería de Autor</strong> · Solo con consumo de alimentos`,
    6:`⚡ HOY SÁBADO: <strong>3 Mojitos por $10.000</strong> · Tradicional o sabores · Solo con consumo de alimentos`
  };
  const el = document.getElementById('promoStrip');
  if(msgs[today]) el.innerHTML = msgs[today];
  else el.style.display = 'none';
})();

/* ── HIGHLIGHT TODAY SCHEDULE ── */
(function markToday(){
  const rows = document.querySelectorAll('.horario-row');
  const map = {1:0,2:0,3:0,4:0,5:1,6:2,0:3};
  if(map[today] !== undefined && rows[map[today]]) rows[map[today]].classList.add('today');
})();

/* ── RENDER PROMOS ── */
(function renderPromos(){
  const grid = document.getElementById('promosGrid');
  if(!grid) return;
  grid.innerHTML = PROMOTIONS.map(p => {
    const isToday = p.day === today;
    return `<article class="promo-card" itemscope itemtype="https://schema.org/Offer">
      <div class="promo-head" style="background:${p.headBg}">
        <span class="promo-day-tag" style="color:${p.headColor}" itemprop="name">${p.dayName}</span>
        <span class="promo-icon">${p.icon}</span>
      </div>
      <div class="promo-body">
        ${isToday ? '<div class="promo-today-badge">🔥 HOY</div>' : ''}
        <div class="promo-product">${p.product}</div>
        <div class="promo-desc">${p.desc}</div>
        <div class="promo-price-main">${p.price}<span class="promo-price-sub">${p.priceSub}</span></div>
        ${p.extra ? `<div class="promo-price-extra">${p.extra}<small>${p.extraSub}</small></div>` : ''}
        <div class="promo-ctas">
          <button class="btn btn-sm btn-ghost" onclick="openResModal()">📅 Reservar</button>
          <a href="https://wa.me/56988252884?text=Hola!%20Me%20interesa%20la%20promo%20del%20${p.dayName.toLowerCase()}" target="_blank" rel="noopener" class="btn btn-sm btn-wa">💬 WhatsApp</a>
        </div>
      </div>
    </article>`;
  }).join('');
})();

/* ── GROUP BY SUBCATEGORY ── */
function groupBySub(items) {
  const groups = {};
  items.forEach(item => {
    const s = item.sub || item.cat;
    if(!groups[s]) groups[s] = [];
    groups[s].push(item);
  });
  return groups;
}

/* ── RENDER PRODUCT ITEM ── */
function renderItem(item, isCocktail) {
  const hhTag = item.priceHH ? `<span class="pi-hh">HH ${fp(item.priceHH)}</span>` : '';
  const altP = item.priceAlt ? `<div class="pi-price-alt">${item.altLabel||'Alt'}: ${fp(item.priceAlt)}</div>` : '';
  const badge = item.badge ? `<span class="pi-badge ${item.badgeCls||'badge-b'}">${item.badge}</span>` : '';
  const esc = s => s.replace(/'/g,"\\'").replace(/"/g,'&quot;');
  return `<div class="product-item" onclick="openProduct('${item.id}','${isCocktail?'coct':'food'}')" role="button" tabindex="0" aria-label="${item.name}, ${fp(item.price)}">
    <div class="pi-emoji">${item.emoji}</div>
    <div class="pi-info">
      <div class="pi-name">${item.name}</div>
      <div class="pi-desc">${item.desc}</div>
    </div>
    <div class="pi-right">
      <div class="pi-price">${fp(item.price)}</div>
      ${altP}
      ${hhTag}
      ${badge}
    </div>
    <button class="pi-add" onclick="event.stopPropagation();addToCart('${item.id}','${isCocktail?'coct':'food'}')" aria-label="Agregar ${esc(item.name)} al carrito">+</button>
  </div>`;
}

/* ── RENDER GROUP LIST ── */
function renderGroups(groups, isCocktail) {
  return Object.entries(groups).map(([sub, items]) => `
    <div class="cat-section">
      <div class="cat-section-title">
        <span class="ct-icon">${items[0].emoji}</span>
        ${sub}
        <span class="ct-count">${items.length} productos</span>
      </div>
      <div class="product-list">
        ${items.map(i => renderItem(i, isCocktail)).join('')}
      </div>
    </div>
  `).join('');
}

/* ── RENDER ALL ── */
function renderFood(items) {
  document.getElementById('foodList').innerHTML = renderGroups(groupBySub(items), false);
}
function renderCoct(items) {
  document.getElementById('coctList').innerHTML = renderGroups(groupBySub(items), true);
}

/* ── FILTER ── */
let foodFilter = 'all', coctFilter = 'all';
let foodSearch = '', coctSearch = '';

function applyFilter(type) {
  const isFood = type === 'food';
  const data = isFood ? FOOD : COCT;
  const cat = isFood ? foodFilter : coctFilter;
  const q = (isFood ? foodSearch : coctSearch).toLowerCase();
  let items = data;
  if(cat !== 'all') items = items.filter(i => i.cat === cat);
  if(q) items = items.filter(i => i.name.toLowerCase().includes(q) || i.desc.toLowerCase().includes(q));
  isFood ? renderFood(items) : renderCoct(items);
}

function filterCat(type, cat, btn) {
  if(type === 'food') foodFilter = cat;
  else coctFilter = cat;
  document.querySelectorAll(`#${type === 'food' ? 'food' : 'coct'}Filters .filter-tab`).forEach(t => t.classList.remove('active'));
  if(btn) btn.classList.add('active');
  applyFilter(type);
}

function searchMenu(type, q) {
  if(type === 'food') foodSearch = q;
  else coctSearch = q;
  applyFilter(type);
}

/* ── ACCORDION ── */
function toggleMenuCard(which) {
  const body = document.getElementById(which === 'comidas' ? 'bodyComidas' : 'bodyCocteleria');
  const card = document.getElementById(which === 'comidas' ? 'cardComidas' : 'cardCocteleria');
  const isOpen = body.classList.toggle('open');
  card.classList.toggle('open');
  if(isOpen) {
    if(which === 'comidas' && !document.querySelector('#foodList .product-item')) renderFood(FOOD);
    if(which === 'cocteleria' && !document.querySelector('#coctList .product-item')) renderCoct(COCT);
  }
}

/* ── PRODUCT MODAL ── */
let currentProduct = null;
let currentQty = 1;

function findProduct(id, type) {
  return type === 'food' ? FOOD.find(i=>i.id===id) : COCT.find(i=>i.id===id);
}

function openProduct(id, type) {
  const p = findProduct(id, type);
  if(!p) return;
  currentProduct = p;
  currentQty = 1;
  document.getElementById('mQty').textContent = 1;
  // Hero
  const hero = document.getElementById('mHero');
  hero.style.background = type === 'coct'
    ? 'linear-gradient(135deg,#0a1f14,#1B4332)'
    : 'linear-gradient(135deg,#1a0a05,#2a1005)';
  document.getElementById('mEmoji').textContent = p.emoji;
  // Info
  document.getElementById('mCat').textContent = (p.sub || p.cat).toUpperCase();
  document.getElementById('mName').textContent = p.name;
  document.getElementById('mDesc').textContent = p.desc;
  document.getElementById('mIngred').textContent = p.ingred || p.desc;
  // Price
  document.getElementById('mPrice').textContent = fp(p.price);
  const altEl = document.getElementById('mPriceAlt');
  altEl.textContent = p.priceAlt ? `${p.altLabel||'Alt'}: ${fp(p.priceAlt)}` : (p.priceHH ? `Happy Hour: ${fp(p.priceHH)}` : '');
  // Tags
  const tagsEl = document.getElementById('mTags');
  let tagsHTML = '';
  if(p.badge) tagsHTML += `<span class="modal-tag ${p.badgeCls||'badge-b'}">${p.badge}</span>`;
  if(p.priceHH) tagsHTML += `<span class="modal-tag badge-g">⏰ Happy Hour ${fp(p.priceHH)}</span>`;
  if(p.promoDay) {
    const dayNames = {2:'Promo Martes',3:'Promo Miércoles',4:'Promo Jueves',5:'Promo Viernes',6:'Promo Sábado'};
    tagsHTML += `<span class="modal-tag badge-r">🔥 ${dayNames[p.promoDay]}</span>`;
  }
  tagsEl.innerHTML = tagsHTML;
  // Pairing
  const pairEl = document.getElementById('mPairing');
  const pairText = document.getElementById('mPairingText');
  if(p.pairing) { pairEl.style.display='block'; pairText.textContent = p.pairing; }
  else pairEl.style.display='none';
  // Related
  buildRelated(p, type);
  // Open
  document.getElementById('productModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function buildRelated(p, type) {
  const pool = type === 'food' ? FOOD : COCT;
  let related = pool.filter(i => i.id !== p.id && i.cat === p.cat).slice(0,3);
  if(related.length < 3) {
    const extra = pool.filter(i => i.id !== p.id && !related.find(r=>r.id===i.id)).slice(0, 3 - related.length);
    related = [...related, ...extra];
  }
  const el = document.getElementById('mRelated');
  el.innerHTML = related.length ? `
    <div class="modal-related-title">👀 También te puede gustar</div>
    <div class="related-grid">
      ${related.map(r => `
        <div class="related-item" onclick="openProduct('${r.id}','${type}')">
          <div class="related-emoji">${r.emoji}</div>
          <div class="related-name">${r.name}</div>
          <div class="related-price">${fp(r.price)}</div>
        </div>`).join('')}
    </div>` : '';
}

function adjustQty(delta) {
  currentQty = Math.max(1, currentQty + delta);
  document.getElementById('mQty').textContent = currentQty;
}

function addFromModal() {
  if(!currentProduct) return;
  addToCartRaw(currentProduct, currentQty);
  showToast(`✓ ${currentProduct.name} × ${currentQty} agregado`);
  closeModal('productModal');
}

function waProduct() {
  if(!currentProduct) return;
  const msg = encodeURIComponent(`Hola Mecharon de Casa! Me interesa el/la "${currentProduct.name}" (${fp(currentProduct.price)}). ¿Está disponible?`);
  window.open(`https://wa.me/56988252884?text=${msg}`, '_blank');
}

function closeProductModal(e) {
  if(e.target === e.currentTarget) {
    document.querySelectorAll('.modal-overlay.open').forEach(m => m.classList.remove('open'));
    document.body.style.overflow = '';
  }
}

function closeModal(id) {
  document.getElementById(id).classList.remove('open');
  document.body.style.overflow = '';
}

/* ── CART ENGINE ── */
let cart = [];

function addToCart(id, type) {
  const p = findProduct(id, type);
  if(p) { addToCartRaw(p, 1); showToast(`✓ ${p.name} agregado al carrito`); }
}

function addToCartRaw(p, qty) {
  const ex = cart.find(i => i.id === p.id);
  if(ex) ex.qty += qty;
  else cart.push({id:p.id, name:p.name, price:p.price, emoji:p.emoji, qty});
  syncCart();
}

function removeFromCart(id) {
  cart = cart.filter(i => i.id !== id);
  syncCart();
}

function changeQty(id, delta) {
  const item = cart.find(i => i.id === id);
  if(!item) return;
  item.qty += delta;
  if(item.qty <= 0) removeFromCart(id);
  else syncCart();
}

function syncCart() {
  const total = cart.reduce((s, i) => s + i.price * i.qty, 0);
  const count = cart.reduce((s, i) => s + i.qty, 0);
  // Badge
  const badge = document.getElementById('cartCount');
  badge.textContent = count;
  badge.style.display = count > 0 ? 'flex' : 'none';
  // Items
  const body = document.getElementById('cartItems');
  const footer = document.getElementById('cartFooter');
  if(!cart.length) {
    body.innerHTML = `<div class="cart-empty"><div class="ce-icon">🛒</div><p class="ce-text">Tu carrito está vacío.<br>Explora nuestra carta.</p></div>`;
    footer.style.display = 'none';
  } else {
    body.innerHTML = cart.map(i => `
      <div class="cart-item">
        <div class="ci-img">${i.emoji}</div>
        <div class="ci-info">
          <div class="ci-name">${i.name}</div>
          <div class="ci-price">${fp(i.price * i.qty)}</div>
          <div class="ci-controls">
            <button class="qty-btn" onclick="changeQty('${i.id}',-1)" aria-label="Reducir">−</button>
            <span class="qty-num">${i.qty}</span>
            <button class="qty-btn" onclick="changeQty('${i.id}',1)" aria-label="Aumentar">+</button>
          </div>
        </div>
        <button class="ci-remove" onclick="removeFromCart('${i.id}')" aria-label="Eliminar">🗑</button>
      </div>`).join('');
    footer.style.display = 'block';
    document.getElementById('cartSubtotal').textContent = fp(total);
    document.getElementById('cartTotal').textContent = fp(total);
  }
}

function toggleCart() {
  document.getElementById('cartDrawer').classList.toggle('open');
  document.getElementById('cartOverlay').classList.toggle('open');
}

function checkout() {
  if(!cart.length) return;
  const total = cart.reduce((s,i) => s + i.price * i.qty, 0);
  // Store cart in sessionStorage for post-payment confirmation
  sessionStorage.setItem('mdc_pending_order', JSON.stringify({cart, total, ts: Date.now()}));
  showToast('🔄 Redirigiendo a Mercado Pago...');
  setTimeout(() => {
    // MP Link de pago directo (Javier Hidalgo A.)
    window.open('https://link.mercadopago.cl/javierhidalgoa', '_blank');
  }, 600);
}

function waOrder() {
  if(!cart.length) return;
  const total = cart.reduce((s,i) => s + i.price * i.qty, 0);
  const lines = cart.map(i => `• ${i.name} ×${i.qty}: ${fp(i.price * i.qty)}`).join('\n');
  const msg = encodeURIComponent(`Hola Mecharon de Casa! Quiero hacer un pedido:\n\n${lines}\n\n💰 TOTAL: ${fp(total)}\n\n¿Tienen delivery a mi zona? ¡Gracias!`);
  window.open(`https://wa.me/56988252884?text=${msg}`, '_blank');
}

/* ── RESERVATION MODAL ── */
function openResModal() {
  const today = new Date().toISOString().split('T')[0];
  ['mRFecha'].forEach(id => { const el = document.getElementById(id); if(el) el.min = today; });
  document.getElementById('resModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function submitResModal() {
  const n = document.getElementById('mRNombre').value.trim();
  const t = document.getElementById('mRTel').value.trim();
  const f = document.getElementById('mRFecha').value;
  const h = document.getElementById('mRHora').value;
  const p = document.getElementById('mRPersonas').value;
  if(!n || !f) { showToast('⚠ Completa nombre y fecha', 'warning'); return; }
  const msg = encodeURIComponent(`Hola Mecharon de Casa! Quiero reservar una mesa:\n\n📋 Nombre: ${n}\n📞 WhatsApp: ${t}\n📅 Fecha: ${f}\n🕐 Hora: ${h}\n👥 ${p}\n\nQuedo esperando confirmación. ¡Gracias!`);
  window.open(`https://wa.me/56988252884?text=${msg}`, '_blank');
  closeModal('resModal');
  showToast('✓ Te redirigimos a WhatsApp');
}

/* ── RESERVATION SECTION ── */
function openReserva() { openResModal(); }

function submitReserva() {
  const n = document.getElementById('rNombre').value.trim();
  const t = document.getElementById('rTel').value.trim();
  const e = document.getElementById('rEmail').value.trim();
  const f = document.getElementById('rFecha').value;
  const h = document.getElementById('rHora').value;
  const p = document.getElementById('rPersonas').value;
  const o = document.getElementById('rOcasion').value;
  if(!n || !f) { showToast('⚠ Completa nombre y fecha', 'warning'); return; }
  const msg = encodeURIComponent(`Hola Mecharon de Casa! Quiero reservar:\n\n📋 Nombre: ${n}\n📞 Tel: ${t}\n📧 Email: ${e}\n📅 Fecha: ${f}\n🕐 Hora: ${h}\n👥 ${p} personas${o ? '\n🎉 Ocasión: '+o : ''}\n\nQuedo esperando confirmación. ¡Gracias!`);
  window.open(`https://wa.me/56988252884?text=${msg}`, '_blank');
  showToast('✓ Reserva enviada por WhatsApp');
}

/* ── NEWSLETTER ── */
function subscribeNL() {
  const v = document.getElementById('nlEmail').value.trim();
  if(!v || !v.includes('@')) { showToast('⚠ Email inválido', 'warning'); return; }
  showToast(`✓ ${v} suscrito exitosamente`);
  document.getElementById('nlEmail').value = '';
}

/* ── TOAST ── */
let toastTimer;
function showToast(msg, type = 'success') {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = `toast show${type !== 'success' ? ' ' + type : ''}`;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 3500);
}

/* ── NAV SCROLL + ACTIVE ── */
window.addEventListener('scroll', () => {
  document.getElementById('nav').classList.toggle('scrolled', window.scrollY > 50);
}, { passive: true });

const sections = ['carta','promociones','delivery','reservas','nosotros','contacto'];
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if(e.isIntersecting) {
      document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
      const link = document.querySelector(`.nav-links a[href="#${e.target.id}"]`);
      if(link) link.classList.add('active');
    }
  });
}, { threshold: 0.3, rootMargin: '-66px 0px 0px 0px' });

sections.forEach(id => {
  const el = document.getElementById(id);
  if(el) observer.observe(el);
});

/* ── MOBILE NAV ── */
function toggleMob() {
  const nav = document.getElementById('mobNav');
  const btn = document.getElementById('hambBtn');
  nav.classList.toggle('open');
  btn.classList.toggle('open');
  nav.setAttribute('aria-hidden', nav.classList.contains('open') ? 'false' : 'true');
}
function closeMob() {
  document.getElementById('mobNav').classList.remove('open');
  document.getElementById('hambBtn').classList.remove('open');
  document.getElementById('mobNav').setAttribute('aria-hidden', 'true');
}

/* ── KEYBOARD ACCESSIBILITY ── */
document.addEventListener('keydown', e => {
  if(e.key === 'Escape') {
    document.querySelectorAll('.modal-overlay.open').forEach(m => m.classList.remove('open'));
    document.getElementById('cartDrawer').classList.remove('open');
    document.getElementById('cartOverlay').classList.remove('open');
    document.body.style.overflow = '';
    closeMob();
  }
});

document.querySelectorAll('.product-item').forEach(el => {
  el.addEventListener('keypress', e => { if(e.key === 'Enter' || e.key === ' ') el.click(); });
});

/* ── INIT DATE ── */
(function(){
  const min = new Date().toISOString().split('T')[0];
  ['rFecha','mRFecha'].forEach(id => { const el = document.getElementById(id); if(el) el.min = min; });
  syncCart();
})();
</script>
</body>
</html>

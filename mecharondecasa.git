<style>
/* ═══════════════════════════════════════════════════
   MECHARON DE CASA — PREMIUM PLATFORM v4.0
   Tokens · Reset · Layout · Components · Sections
   ═══════════════════════════════════════════════════ */
:root{
  --c-black:#121212; --c-gray1:#1A1A1A; --c-gray2:#222222; --c-gray3:#2A2A2A;
  --c-gray4:#333333; --c-gray5:#444444; --c-muted:#888888; --c-white:#F7F5F0;
  --c-yellow:#F5C400; --c-yellow-d:#D4A900; --c-red:#C1121F; --c-red-d:#9E0F19;
  --c-green:#1B4332; --c-wa:#25D366;
  --font-d:'Bebas Neue',sans-serif;
  --font-s:'Playfair Display',serif;
  --font-b:'DM Sans',sans-serif;
  --r:4px; --r-lg:8px;
  --t:.28s cubic-bezier(.4,0,.2,1);
  --shadow-sm:0 2px 8px rgba(0,0,0,.4);
  --shadow-md:0 6px 24px rgba(0,0,0,.5);
  --shadow-lg:0 16px 48px rgba(0,0,0,.6);
  --shadow-y:0 8px 32px rgba(245,196,0,.2);
  --shadow-r:0 8px 32px rgba(193,18,31,.25);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;font-size:16px}
body{background:var(--c-black);color:var(--c-white);font-family:var(--font-b);overflow-x:hidden;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
img{max-width:100%;display:block;height:auto}
a{color:inherit;text-decoration:none}
button{font-family:var(--font-b);cursor:pointer;border:none;background:none}
input,select,textarea{font-family:var(--font-b)}
ul{list-style:none}
::-webkit-scrollbar{width:3px;height:3px}
::-webkit-scrollbar-track{background:var(--c-black)}
::-webkit-scrollbar-thumb{background:var(--c-yellow);border-radius:2px}
::selection{background:var(--c-yellow);color:var(--c-black)}
:focus-visible{outline:2px solid var(--c-yellow);outline-offset:2px}

/* ─── UTILITY ─── */
.u-container{width:100%;max-width:1280px;margin:0 auto;padding:0 1.5rem}
@media(min-width:768px){.u-container{padding:0 2.5rem}}
@media(min-width:1280px){.u-container{padding:0 3rem}}
.u-section{padding:5rem 0}
@media(min-width:900px){.u-section{padding:7.5rem 0}}
.u-tag{font-size:.58rem;letter-spacing:.45em;text-transform:uppercase;color:var(--c-yellow);display:block;margin-bottom:.85rem}
.u-title{font-family:var(--font-d);font-size:clamp(2.2rem,5.5vw,4.5rem);line-height:.92;letter-spacing:.02em}
.u-title em{font-family:var(--font-s);font-style:italic;color:var(--c-yellow);display:block}
.u-divider{width:48px;height:1px;background:var(--c-yellow);margin:1.5rem auto}
.u-sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

/* ─── BUTTONS ─── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.45rem;padding:.85rem 1.85rem;font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;border-radius:var(--r);transition:all var(--t);white-space:nowrap;cursor:pointer;border:none}
.btn-lg{padding:1rem 2.5rem;font-size:.78rem}
.btn-sm{padding:.48rem .95rem;font-size:.62rem}
.btn-yellow{background:var(--c-yellow);color:var(--c-black)}
.btn-yellow:hover{background:var(--c-white);transform:translateY(-2px);box-shadow:var(--shadow-y)}
.btn-red{background:var(--c-red);color:#fff}
.btn-red:hover{background:var(--c-red-d);transform:translateY(-2px);box-shadow:var(--shadow-r)}
.btn-outline{background:transparent;color:var(--c-white);border:1.5px solid rgba(247,245,240,.22)}
.btn-outline:hover{border-color:var(--c-yellow);color:var(--c-yellow);transform:translateY(-2px)}
.btn-ghost{background:rgba(255,255,255,.05);color:var(--c-white);border:1px solid rgba(255,255,255,.08)}
.btn-ghost:hover{background:rgba(245,196,0,.08);border-color:rgba(245,196,0,.3);color:var(--c-yellow)}
.btn-wa{background:var(--c-wa);color:#fff}
.btn-wa:hover{background:#1ab855;transform:translateY(-2px)}
.btn-dark{background:rgba(255,255,255,.06);color:var(--c-white);border:1px solid rgba(255,255,255,.1)}
.btn-dark:hover{background:rgba(245,196,0,.1);border-color:var(--c-yellow);color:var(--c-yellow)}

/* ─── PROMO STRIP ─── */
#promoStrip{background:linear-gradient(90deg,var(--c-red),#8B0000,var(--c-red));background-size:300%;animation:gradShift 5s linear infinite;padding:.65rem 1.5rem;text-align:center;font-size:.68rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#fff;position:relative;z-index:901}
#promoStrip strong{color:var(--c-yellow)}

/* ─── NAVBAR ─── */
#nav{position:fixed;top:0;left:0;right:0;z-index:900;height:66px;display:flex;align-items:center;justify-content:space-between;padding:0 1.5rem;background:rgba(18,18,18,.94);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid rgba(245,196,0,.1);transition:all var(--t)}
#nav.scrolled{box-shadow:0 2px 30px rgba(0,0,0,.6);background:rgba(18,18,18,.98)}
.nav-brand{display:flex;flex-direction:column;line-height:1;gap:3px;text-decoration:none}
.nav-brand-name{font-family:var(--font-d);font-size:1.25rem;letter-spacing:.07em;color:var(--c-white)}
.nav-brand-sub{font-size:.47rem;letter-spacing:.45em;text-transform:uppercase;color:var(--c-yellow)}
.nav-links{display:none;gap:1.5rem}
@media(min-width:1024px){.nav-links{display:flex}}
.nav-links a{font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(247,245,240,.7);position:relative;padding:.25rem 0;transition:color var(--t)}
.nav-links a::after{content:'';position:absolute;bottom:-2px;left:0;width:0;height:1px;background:var(--c-yellow);transition:width var(--t)}
.nav-links a:hover,.nav-links a.active{color:var(--c-yellow)}
.nav-links a:hover::after,.nav-links a.active::after{width:100%}
.nav-right{display:flex;align-items:center;gap:.6rem}
.nav-cart-btn{position:relative;display:flex;align-items:center;gap:.4rem;background:rgba(245,196,0,.1);border:1px solid rgba(245,196,0,.28);color:var(--c-yellow);padding:.42rem .85rem;font-size:.65rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border-radius:var(--r);transition:all var(--t)}
.nav-cart-btn:hover{background:var(--c-yellow);color:var(--c-black)}
.cart-count{position:absolute;top:-6px;right:-6px;background:var(--c-red);color:#fff;width:16px;height:16px;border-radius:50%;font-size:.55rem;display:flex;align-items:center;justify-content:center;font-weight:800;border:1.5px solid var(--c-black)}
.btn-reserva-nav{display:none}
@media(min-width:768px){.btn-reserva-nav{display:inline-flex}}
.hamburger{display:flex;flex-direction:column;gap:4px;padding:6px;cursor:pointer}
@media(min-width:1024px){.hamburger{display:none}}
.hamburger span{display:block;width:20px;height:1.5px;background:var(--c-white);border-radius:1px;transition:all var(--t)}
.hamburger.open span:nth-child(1){transform:translateY(5.5px) rotate(45deg)}
.hamburger.open span:nth-child(2){opacity:0;transform:scaleX(0)}
.hamburger.open span:nth-child(3){transform:translateY(-5.5px) rotate(-45deg)}

/* ─── MOBILE NAV ─── */
.mob-nav{position:fixed;top:66px;left:0;right:0;background:rgba(26,26,26,.98);backdrop-filter:blur(20px);border-bottom:1px solid rgba(245,196,0,.1);z-index:899;transform:translateY(-105%);transition:transform var(--t)}
.mob-nav.open{transform:translateY(0)}
.mob-nav-inner{padding:1.25rem 1.5rem}
.mob-nav-links{display:flex;flex-direction:column;gap:.1rem;margin-bottom:1.25rem}
.mob-nav-links a{display:flex;align-items:center;justify-content:space-between;padding:.75rem .5rem;font-size:.88rem;font-weight:500;color:rgba(247,245,240,.85);border-bottom:1px solid rgba(255,255,255,.04);transition:all var(--t)}
.mob-nav-links a:hover{color:var(--c-yellow);padding-left:.75rem}
.mob-nav-ctas{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}

/* ─── HERO ─── */
#hero{min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden;padding-top:66px}
.hero-bg{position:absolute;inset:0;background:
  radial-gradient(ellipse 80% 60% at 10% 60%,rgba(27,67,50,.38) 0%,transparent 60%),
  radial-gradient(ellipse 65% 55% at 90% 15%,rgba(193,18,31,.2) 0%,transparent 55%),
  radial-gradient(ellipse 55% 45% at 60% 90%,rgba(245,196,0,.06) 0%,transparent 55%),
  #121212}
.hero-dots{position:absolute;inset:0;background-image:radial-gradient(rgba(245,196,0,.06) 1px,transparent 1px);background-size:30px 30px;mask-image:radial-gradient(ellipse 70% 70% at 50% 50%,black 20%,transparent 75%)}
.hero-content{position:relative;z-index:2;text-align:center;padding:3rem 1.5rem 5rem;max-width:1050px;width:100%}
.hero-eyebrow{display:inline-flex;align-items:center;gap:.6rem;font-size:.56rem;letter-spacing:.5em;text-transform:uppercase;color:var(--c-yellow);border:1px solid rgba(245,196,0,.22);padding:.38rem 1.25rem;border-radius:var(--r);margin-bottom:2rem;animation:fadeDown .9s ease both}
.hero-title{font-family:var(--font-d);font-size:clamp(4.5rem,16vw,12rem);line-height:.85;letter-spacing:.015em;margin-bottom:1rem;animation:fadeUp .9s ease .1s both}
.hero-title .accent{color:var(--c-yellow)}
.hero-title .stroke{-webkit-text-stroke:1px rgba(247,245,240,.25);color:transparent}
.hero-tagline{font-family:var(--font-s);font-style:italic;font-size:clamp(.85rem,2.2vw,1.25rem);color:rgba(247,245,240,.55);margin-bottom:2.5rem;animation:fadeUp .9s ease .25s both;letter-spacing:.02em}
.hero-ctas{display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;animation:fadeUp .9s ease .4s both;margin-bottom:3rem}
.hero-scroll{position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:.4rem;animation:fadeUp 1s ease .8s both}
.hero-scroll-text{font-size:.55rem;letter-spacing:.4em;text-transform:uppercase;color:var(--c-muted)}
.hero-scroll-line{width:1px;height:36px;background:linear-gradient(to bottom,var(--c-yellow),transparent)}

/* ─── STATS BAR ─── */
.stats-bar{background:var(--c-gray1);border-top:1px solid rgba(245,196,0,.1);border-bottom:1px solid rgba(245,196,0,.1);padding:1.35rem 1.5rem}
.stats-inner{display:flex;justify-content:center;gap:1.5rem;flex-wrap:wrap;max-width:1280px;margin:0 auto}
.stat{display:flex;align-items:center;gap:.75rem;padding:.35rem 0}
.stat-num{font-family:var(--font-d);font-size:2rem;color:var(--c-yellow);line-height:1}
.stat-label{font-size:.56rem;letter-spacing:.2em;text-transform:uppercase;color:var(--c-muted);line-height:1.4;max-width:65px}

/* ─── MENU SECTION ─── */
#carta{background:var(--c-gray1)}
.menu-hero{text-align:center;padding-bottom:3.5rem}
.menu-cards-grid{display:grid;grid-template-columns:1fr;gap:1.5rem;max-width:960px;margin:0 auto}
@media(min-width:680px){.menu-cards-grid{grid-template-columns:1fr 1fr}}

/* MAIN MENU CARDS */
.menu-main-card{border-radius:var(--r-lg);overflow:hidden;cursor:pointer;transition:all var(--t);position:relative}
.menu-main-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
.mmc-header{padding:2.5rem 2rem;display:flex;align-items:center;gap:1.25rem;position:relative;overflow:hidden}
.mmc-header::before{content:'';position:absolute;inset:0;opacity:.08}
.mmc-food .mmc-header{background:linear-gradient(135deg,#2A1A0A,#1A1A1A);border:1px solid rgba(245,196,0,.18)}
.mmc-food .mmc-header::before{background:radial-gradient(circle at 80% 50%,var(--c-yellow),transparent 65%)}
.mmc-cocktail .mmc-header{background:linear-gradient(135deg,#0A1A2A,#1A1A1A);border:1px solid rgba(193,18,31,.2)}
.mmc-cocktail .mmc-header::before{background:radial-gradient(circle at 80% 50%,var(--c-red),transparent 65%)}
.mmc-emoji{font-size:3.5rem;line-height:1;flex-shrink:0;filter:drop-shadow(0 4px 12px rgba(0,0,0,.4))}
.mmc-info{flex:1}
.mmc-title{font-family:var(--font-d);font-size:2.2rem;letter-spacing:.04em;line-height:.95;margin-bottom:.4rem}
.mmc-sub{font-size:.68rem;color:var(--c-muted);letter-spacing:.1em;text-transform:uppercase}
.mmc-count{font-size:.6rem;color:var(--c-yellow);letter-spacing:.12em;text-transform:uppercase;margin-top:.2rem}
.mmc-arrow{font-size:1.4rem;color:var(--c-yellow);transition:transform var(--t);flex-shrink:0}
.menu-main-card.open .mmc-arrow{transform:rotate(90deg)}

/* ACCORDION BODY */
.accordion-body{max-height:0;overflow:hidden;background:var(--c-black);border:1px solid rgba(255,255,255,.05);border-top:none;border-radius:0 0 var(--r-lg) var(--r-lg);transition:max-height .5s cubic-bezier(.4,0,.2,1)}
.accordion-body.open{max-height:4000px}
.accordion-inner{padding:1.75rem}

/* SEARCH BAR */
.menu-search-wrap{position:relative;margin-bottom:1.5rem}
.menu-search{width:100%;background:var(--c-gray2);border:1px solid rgba(255,255,255,.08);color:var(--c-white);padding:.75rem 1rem .75rem 2.75rem;font-family:var(--font-b);font-size:.82rem;border-radius:var(--r);outline:none;transition:border-color var(--t)}
.menu-search:focus{border-color:rgba(245,196,0,.4);background:rgba(245,196,0,.03)}
.menu-search-icon{position:absolute;left:.9rem;top:50%;transform:translateY(-50%);color:var(--c-muted);font-size:.9rem;pointer-events:none}
.menu-search::placeholder{color:var(--c-muted)}

/* FILTER TABS */
.filter-tabs{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1.75rem;padding-bottom:.25rem;overflow-x:auto;scrollbar-width:none}
.filter-tabs::-webkit-scrollbar{display:none}
.filter-tab{padding:.4rem .9rem;font-size:.6rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;border:1px solid rgba(255,255,255,.1);background:transparent;color:var(--c-muted);border-radius:var(--r);transition:all var(--t);white-space:nowrap;cursor:pointer}
.filter-tab:hover{border-color:rgba(245,196,0,.35);color:var(--c-yellow)}
.filter-tab.active{background:var(--c-yellow);color:var(--c-black);border-color:var(--c-yellow);font-weight:700}

/* CATEGORY GROUP */
.cat-section{margin-bottom:2rem}
.cat-section:last-child{margin-bottom:0}
.cat-section-title{display:flex;align-items:center;gap:.75rem;font-family:var(--font-d);font-size:1.05rem;color:var(--c-yellow);letter-spacing:.06em;margin-bottom:1rem;padding-bottom:.6rem;border-bottom:1px solid rgba(245,196,0,.15)}
.cat-section-title .ct-icon{font-size:1.1rem}
.cat-section-title .ct-count{font-family:var(--font-b);font-size:.6rem;color:var(--c-muted);letter-spacing:.1em;font-weight:400;margin-left:auto;text-transform:uppercase}

/* PRODUCT LIST ITEMS */
.product-list{display:flex;flex-direction:column;gap:.45rem}
.product-item{display:flex;align-items:center;gap:.85rem;padding:.65rem .75rem;background:var(--c-gray2);border:1px solid rgba(255,255,255,.04);border-radius:var(--r);transition:all var(--t);cursor:pointer}
.product-item:hover{border-color:rgba(245,196,0,.2);background:var(--c-gray3);transform:translateX(3px)}
.pi-emoji{width:38px;height:38px;background:var(--c-gray3);border-radius:var(--r);display:flex;align-items:center;justify-content:center;font-size:1.25rem;flex-shrink:0}
.pi-info{flex:1;min-width:0}
.pi-name{font-size:.82rem;font-weight:600;color:var(--c-white);line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pi-desc{font-size:.68rem;color:var(--c-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:.1rem}
.pi-right{display:flex;flex-direction:column;align-items:flex-end;gap:.25rem;flex-shrink:0}
.pi-price{font-family:var(--font-d);font-size:1.15rem;color:var(--c-yellow);line-height:1}
.pi-price-alt{font-size:.58rem;color:var(--c-muted);text-align:right}
.pi-badge{font-size:.5rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:.15rem .4rem;border-radius:2px;text-align:right}
.badge-r{background:var(--c-red);color:#fff}
.badge-y{background:var(--c-yellow);color:var(--c-black)}
.badge-g{background:var(--c-green);color:var(--c-yellow)}
.badge-b{background:rgba(255,255,255,.1);color:var(--c-white);border:1px solid rgba(255,255,255,.15)}
.pi-add{width:28px;height:28px;background:var(--c-yellow);color:var(--c-black);border-radius:var(--r);font-size:1.1rem;font-weight:800;display:flex;align-items:center;justify-content:center;transition:all var(--t);flex-shrink:0;border:none;cursor:pointer}
.pi-add:hover{background:var(--c-white);transform:scale(1.1)}
.pi-hh{font-size:.55rem;color:var(--c-green);background:rgba(27,67,50,.35);border:1px solid rgba(27,67,50,.6);padding:.12rem .4rem;border-radius:2px;text-transform:uppercase;letter-spacing:.08em}

/* ─── PROMOTIONS ─── */
#promociones{background:var(--c-black);position:relative;overflow:hidden}
#promociones::before{content:'PROMOS';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:var(--font-d);font-size:clamp(8rem,18vw,16rem);color:rgba(245,196,0,.018);pointer-events:none;user-select:none;white-space:nowrap}
.promos-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1.25rem;position:relative;z-index:1}
.promo-card{background:var(--c-gray1);border:1px solid rgba(245,196,0,.1);border-radius:var(--r-lg);overflow:hidden;transition:all var(--t)}
.promo-card:hover{transform:translateY(-6px);border-color:rgba(245,196,0,.4);box-shadow:var(--shadow-y)}
.promo-head{padding:.95rem 1.25rem;display:flex;align-items:center;justify-content:space-between}
.promo-day-tag{font-family:var(--font-d);font-size:1.65rem;letter-spacing:.04em;line-height:1}
.promo-icon{font-size:1.5rem}
.promo-body{padding:1.25rem}
.promo-product{font-family:var(--font-s);font-size:1.05rem;font-weight:700;margin-bottom:.4rem;line-height:1.25}
.promo-desc{font-size:.73rem;color:var(--c-muted);line-height:1.7;margin-bottom:.9rem}
.promo-price-main{font-family:var(--font-d);font-size:2rem;color:var(--c-yellow);line-height:1}
.promo-price-sub{font-family:var(--font-b);font-size:.6rem;color:var(--c-muted);display:block;letter-spacing:.1em;text-transform:uppercase;margin-top:.15rem}
.promo-price-extra{font-family:var(--font-d);font-size:1.35rem;color:var(--c-yellow);margin-top:.5rem;padding-top:.6rem;border-top:1px solid rgba(255,255,255,.06)}
.promo-price-extra small{font-family:var(--font-b);font-size:.58rem;color:var(--c-muted);text-transform:uppercase;letter-spacing:.1em;display:block}
.promo-today-badge{display:inline-flex;align-items:center;gap:.3rem;background:var(--c-red);color:#fff;font-size:.55rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:.2rem .55rem;border-radius:2px;margin-bottom:.65rem}
.promo-ctas{display:flex;gap:.5rem;margin-top:1rem;flex-wrap:wrap}
.promo-disclaimer{text-align:center;margin-top:2.5rem;padding-top:2rem;border-top:1px solid rgba(255,255,255,.05);font-size:.72rem;color:var(--c-muted)}
.promo-disclaimer strong{color:var(--c-red)}

/* ─── DELIVERY ─── */
#delivery{background:var(--c-gray1)}
.delivery-layout{display:grid;gap:3rem;max-width:1200px;margin:0 auto}
@media(min-width:900px){.delivery-layout{grid-template-columns:1fr 1fr;align-items:start}}
.delivery-text .big-title{font-family:var(--font-d);font-size:clamp(3rem,8vw,6rem);line-height:.88;margin-bottom:1.5rem}
.delivery-text .big-title em{font-family:var(--font-s);font-style:italic;color:var(--c-red);display:block}
.delivery-text p{font-size:.84rem;color:var(--c-muted);line-height:1.8;margin-bottom:1.75rem}
.delivery-btns-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
.d-btn{display:flex;align-items:center;gap:.85rem;padding:1.1rem;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:var(--r-lg);transition:all var(--t);text-decoration:none;cursor:pointer}
.d-btn:hover{border-color:rgba(245,196,0,.28);background:rgba(245,196,0,.04);transform:translateY(-3px);box-shadow:var(--shadow-sm)}
.d-btn-icon{font-size:1.6rem;flex-shrink:0}
.d-btn-name{font-size:.8rem;font-weight:700;color:var(--c-white)}
.d-btn-sub{font-size:.6rem;color:var(--c-muted);text-transform:uppercase;letter-spacing:.1em;margin-top:.1rem}
.zones-card{background:var(--c-gray2);border:1px solid rgba(255,255,255,.05);border-radius:var(--r-lg);padding:1.75rem}
.zones-title{font-family:var(--font-d);font-size:1.3rem;color:var(--c-yellow);letter-spacing:.05em;margin-bottom:1.35rem}
.zone-row{display:flex;align-items:center;justify-content:space-between;padding:.65rem 0;border-bottom:1px solid rgba(255,255,255,.04);font-size:.78rem}
.zone-row:last-child{border-bottom:none}
.zone-name{color:var(--c-white);display:flex;align-items:center;gap:.4rem}
.zone-time{color:var(--c-yellow);font-weight:700;font-size:.72rem}
.zone-cost{color:var(--c-muted);font-size:.68rem}
.zones-note{margin-top:1.25rem;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,.04);font-size:.7rem;color:var(--c-muted);text-align:center;line-height:1.6}

/* ─── RESERVAS ─── */
#reservas{background:var(--c-black)}
.reservas-layout{display:grid;gap:3rem;max-width:980px;margin:0 auto}
@media(min-width:768px){.reservas-layout{grid-template-columns:1fr 1fr;align-items:start}}
.reservas-info .big-title{font-family:var(--font-d);font-size:clamp(2.5rem,6vw,4.5rem);line-height:.9;margin-bottom:1.5rem}
.reservas-info .big-title em{font-family:var(--font-s);font-style:italic;color:var(--c-yellow);display:block}
.reservas-info p{font-size:.83rem;color:var(--c-muted);line-height:1.8;margin-bottom:1.5rem}
.horarios-list{display:flex;flex-direction:column;gap:0;margin-bottom:1.5rem;border:1px solid rgba(255,255,255,.06);border-radius:var(--r);overflow:hidden}
.horario-row{display:flex;justify-content:space-between;align-items:center;padding:.6rem .9rem;border-bottom:1px solid rgba(255,255,255,.04);font-size:.78rem}
.horario-row:last-child{border-bottom:none}
.horario-row.today{background:rgba(245,196,0,.06);border-color:rgba(245,196,0,.12)}
.horario-dia{color:var(--c-muted);font-size:.68rem;text-transform:uppercase;letter-spacing:.1em}
.horario-hora{color:var(--c-white);font-weight:600}
.res-form-card{background:var(--c-gray2);border:1px solid rgba(245,196,0,.12);border-radius:var(--r-lg);padding:2rem}
.form-title{font-family:var(--font-d);font-size:1.35rem;color:var(--c-yellow);letter-spacing:.05em;margin-bottom:1.75rem}
.fg{margin-bottom:1rem}
.fl{display:block;font-size:.58rem;letter-spacing:.22em;text-transform:uppercase;color:var(--c-yellow);margin-bottom:.4rem;font-weight:600}
.fi{width:100%;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);color:var(--c-white);padding:.72rem .9rem;font-family:var(--font-b);font-size:.82rem;border-radius:var(--r);outline:none;transition:border-color var(--t);-webkit-appearance:none;appearance:none}
.fi:focus{border-color:rgba(245,196,0,.45);background:rgba(245,196,0,.03)}
.fi option{background:var(--c-gray2);color:var(--c-white)}
.fg-row{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
.btn-form{width:100%;background:var(--c-yellow);color:var(--c-black);border:none;padding:.95rem;font-family:var(--font-b);font-size:.78rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;border-radius:var(--r);transition:all var(--t);cursor:pointer;margin-top:.5rem}
.btn-form:hover{background:var(--c-white)}
.form-note{text-align:center;font-size:.65rem;color:var(--c-muted);margin-top:.75rem;line-height:1.5}

/* ─── NEWSLETTER ─── */
.nl-strip{background:var(--c-yellow);padding:2rem 1.5rem;display:flex;align-items:center;justify-content:center;gap:2rem;flex-wrap:wrap}
.nl-text h3{font-family:var(--font-d);font-size:1.5rem;color:var(--c-black);letter-spacing:.05em;line-height:1}
.nl-text p{font-size:.72rem;color:rgba(18,18,18,.6);margin-top:.2rem}
.nl-form{display:flex;border-radius:var(--r);overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.25)}
.nl-input{padding:.75rem 1.25rem;border:none;background:var(--c-black);color:var(--c-white);font-family:var(--font-b);font-size:.8rem;min-width:210px;outline:none}
.nl-submit{background:var(--c-black);color:var(--c-yellow);border:none;padding:.75rem 1.25rem;font-family:var(--font-b);font-size:.7rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:all var(--t)}
.nl-submit:hover{background:var(--c-red);color:#fff}

/* ─── NOSOTROS ─── */
#nosotros{background:var(--c-gray1)}
.nosotros-layout{display:grid;gap:3.5rem;max-width:1200px;margin:0 auto}
@media(min-width:900px){.nosotros-layout{grid-template-columns:1fr 1fr;align-items:center;gap:5rem}}
.nosotros-text .big-title{font-family:var(--font-d);font-size:clamp(3rem,7vw,5.5rem);line-height:.9;margin-bottom:1.5rem}
.nosotros-text .big-title em{font-family:var(--font-s);font-style:italic;color:var(--c-yellow);display:block}
.nosotros-text p{font-size:.84rem;color:var(--c-muted);line-height:1.85;margin-bottom:1.1rem}
.values-grid{display:grid;grid-template-columns:1fr 1fr;gap:.85rem;margin-top:1.75rem}
.val-card{background:rgba(245,196,0,.04);border:1px solid rgba(245,196,0,.1);border-radius:var(--r);padding:1rem}
.val-icon{font-size:1.3rem;margin-bottom:.35rem}
.val-title{font-family:var(--font-d);font-size:.88rem;color:var(--c-yellow);letter-spacing:.05em;margin-bottom:.25rem}
.val-text{font-size:.7rem;color:var(--c-muted);line-height:1.55}
.quote-box{background:var(--c-gray2);border:1px solid rgba(245,196,0,.12);border-radius:var(--r-lg);padding:2rem;position:relative;overflow:hidden}
.quote-box::before{content:'"';position:absolute;top:-1rem;left:.75rem;font-family:var(--font-s);font-size:9rem;color:rgba(245,196,0,.06);line-height:1;pointer-events:none}
.quote-text{font-family:var(--font-s);font-style:italic;font-size:1.1rem;line-height:1.65;color:var(--c-white);margin-bottom:1.5rem;position:relative;z-index:1}
.quote-divider{display:flex;align-items:center;gap:.75rem;margin-bottom:1.5rem}
.qd-line{flex:1;height:1px;background:rgba(245,196,0,.2)}
.qd-text{font-size:.55rem;letter-spacing:.35em;text-transform:uppercase;color:var(--c-yellow)}
.quote-stats{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1.5rem}
.qs-item{text-align:center;padding:.85rem;background:rgba(245,196,0,.04);border:1px solid rgba(245,196,0,.1);border-radius:var(--r)}
.qs-num{font-family:var(--font-d);font-size:2rem;color:var(--c-yellow);line-height:1}
.qs-label{font-size:.6rem;color:var(--c-muted);letter-spacing:.15em;text-transform:uppercase;margin-top:.2rem}

/* ─── CONTACTO ─── */
#contacto{background:var(--c-black)}
.contacto-layout{display:grid;gap:3rem;max-width:1200px;margin:0 auto}
@media(min-width:900px){.contacto-layout{grid-template-columns:1fr 1fr}}
.contact-list{display:flex;flex-direction:column;gap:.75rem;margin-top:1.75rem}
.contact-item{display:flex;align-items:flex-start;gap:1rem;padding:.9rem;border:1px solid rgba(255,255,255,.05);border-radius:var(--r);transition:all var(--t)}
.contact-item:hover{border-color:rgba(245,196,0,.22);background:rgba(245,196,0,.03)}
.contact-ic{width:38px;height:38px;background:rgba(245,196,0,.08);border-radius:var(--r);display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0}
.contact-lbl{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--c-yellow);margin-bottom:.2rem;font-weight:600}
.contact-val{font-size:.82rem;color:var(--c-white)}
.map-placeholder{background:var(--c-gray2);border:1px solid rgba(255,255,255,.05);border-radius:var(--r-lg);min-height:380px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;text-align:center;padding:2rem}
.map-icon{font-size:2.5rem}
.map-title{font-family:var(--font-d);font-size:1.4rem;color:var(--c-yellow);letter-spacing:.05em}
.map-sub{font-size:.78rem;color:var(--c-muted);max-width:240px;line-height:1.6}

/* ─── FOOTER ─── */
footer{background:#0A0A0A;border-top:1px solid rgba(245,196,0,.07);padding:3.5rem 1.5rem 1.5rem}
.footer-layout{display:grid;gap:2.5rem;max-width:1280px;margin:0 auto 2.5rem}
@media(min-width:640px){.footer-layout{grid-template-columns:1fr 1fr}}
@media(min-width:1024px){.footer-layout{grid-template-columns:2.2fr 1fr 1fr 1fr}}
.footer-brand-name{font-family:var(--font-d);font-size:1.65rem;letter-spacing:.05em;margin-bottom:.2rem}
.footer-brand-sub{font-size:.52rem;letter-spacing:.45em;text-transform:uppercase;color:var(--c-yellow);margin-bottom:1.25rem}
.footer-tagline{font-size:.78rem;color:var(--c-muted);line-height:1.8;max-width:280px;margin-bottom:1.25rem}
.footer-socials{display:flex;gap:.55rem;flex-wrap:wrap}
.social-icon{width:38px;height:38px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);border-radius:var(--r);display:flex;align-items:center;justify-content:center;font-size:.95rem;transition:all var(--t);text-decoration:none}
.social-icon:hover{background:var(--c-yellow);border-color:var(--c-yellow);transform:translateY(-2px)}
.footer-col h4{font-family:var(--font-d);font-size:.78rem;letter-spacing:.15em;text-transform:uppercase;color:var(--c-yellow);margin-bottom:.85rem}
.footer-links{display:flex;flex-direction:column;gap:.45rem}
.footer-links a{font-size:.73rem;color:var(--c-muted);transition:color var(--t);display:flex;align-items:center;gap:.35rem}
.footer-links a::before{content:'→';font-size:.52rem;color:var(--c-yellow);opacity:0;transition:all var(--t)}
.footer-links a:hover{color:var(--c-yellow);padding-left:.3rem}
.footer-links a:hover::before{opacity:1}
.footer-bottom{border-top:1px solid rgba(255,255,255,.05);padding-top:1.5rem;display:flex;justify-content:space-between;align-items:center;max-width:1280px;margin:0 auto;flex-wrap:wrap;gap:.75rem}
.footer-copy{font-size:.67rem;color:var(--c-muted)}
.footer-est{font-family:var(--font-d);font-size:.82rem;color:rgba(245,196,0,.22);letter-spacing:.2em}

/* ─── CART SIDEBAR ─── */
.cart-overlay{position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:1800;opacity:0;pointer-events:none;transition:opacity var(--t)}
.cart-overlay.open{opacity:1;pointer-events:all}
.cart-drawer{position:fixed;top:0;right:min(-460px,-100vw);width:min(460px,100vw);height:100dvh;background:var(--c-gray2);z-index:1801;display:flex;flex-direction:column;border-left:1px solid rgba(245,196,0,.12);transition:right .38s cubic-bezier(.4,0,.2,1)}
.cart-drawer.open{right:0}
.cart-header{padding:1.25rem;border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-shrink:0}
.cart-header h3{font-family:var(--font-d);font-size:1.5rem;letter-spacing:.05em}
.cart-items{flex:1;overflow-y:auto;padding:1rem}
.cart-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:.75rem;color:var(--c-muted);text-align:center;padding:2rem}
.ce-icon{font-size:3.5rem;opacity:.4}
.ce-text{font-size:.8rem;line-height:1.6}
.cart-item{display:flex;gap:.75rem;padding:.75rem;background:var(--c-black);border-radius:var(--r);margin-bottom:.65rem;border:1px solid rgba(255,255,255,.04)}
.ci-img{width:48px;height:48px;background:var(--c-gray3);border-radius:var(--r);display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0}
.ci-info{flex:1;min-width:0}
.ci-name{font-size:.8rem;font-weight:600;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ci-price{font-size:.72rem;color:var(--c-yellow);margin-top:.1rem}
.ci-controls{display:flex;align-items:center;gap:.4rem;margin-top:.4rem}
.qty-btn{width:22px;height:22px;background:rgba(255,255,255,.08);border:none;color:var(--c-white);border-radius:2px;font-size:.75rem;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s}
.qty-btn:hover{background:var(--c-yellow);color:var(--c-black)}
.qty-num{font-size:.82rem;font-weight:700;min-width:18px;text-align:center}
.ci-remove{background:none;border:none;color:var(--c-muted);font-size:.8rem;padding:.2rem;cursor:pointer;transition:color .2s;margin-left:auto}
.ci-remove:hover{color:var(--c-red)}
.cart-footer{padding:1.25rem;border-top:1px solid rgba(255,255,255,.07);flex-shrink:0}
.cart-subtotal{display:flex;justify-content:space-between;font-size:.75rem;color:var(--c-muted);margin-bottom:.4rem}
.cart-total-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem}
.cart-total-label{font-family:var(--font-d);font-size:1rem;letter-spacing:.08em}
.cart-total-amount{font-family:var(--font-d);font-size:2rem;color:var(--c-yellow);line-height:1}
.btn-checkout{width:100%;background:var(--c-yellow);color:var(--c-black);border:none;padding:1rem;font-family:var(--font-b);font-size:.8rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;border-radius:var(--r);cursor:pointer;transition:all var(--t);margin-bottom:.6rem}
.btn-checkout:hover{background:var(--c-white)}
.btn-cart-wa{width:100%;background:rgba(37,211,102,.1);color:var(--c-wa);border:1px solid rgba(37,211,102,.22);padding:.85rem;font-family:var(--font-b);font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;border-radius:var(--r);cursor:pointer;transition:all var(--t);display:flex;align-items:center;justify-content:center;gap:.4rem}
.btn-cart-wa:hover{background:var(--c-wa);color:#fff}

/* ─── PRODUCT MODAL ─── */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:2000;display:flex;align-items:center;justify-content:center;padding:1rem;opacity:0;pointer-events:none;transition:opacity var(--t)}
.modal-overlay.open{opacity:1;pointer-events:all}
.modal-box{background:var(--c-gray2);border:1px solid rgba(245,196,0,.15);border-radius:var(--r-lg);width:100%;max-width:580px;max-height:92dvh;overflow-y:auto;transform:scale(.96) translateY(10px);transition:transform var(--t)}
.modal-overlay.open .modal-box{transform:scale(1) translateY(0)}
.modal-hero{background:var(--c-gray3);height:200px;display:flex;align-items:center;justify-content:center;font-size:6rem;position:relative;overflow:hidden;border-radius:var(--r-lg) var(--r-lg) 0 0}
.modal-hero::after{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,transparent 30%,rgba(34,34,34,.6))}
.modal-close{position:absolute;top:1rem;right:1rem;width:36px;height:36px;background:rgba(18,18,18,.8);border:1px solid rgba(255,255,255,.15);border-radius:var(--r);color:var(--c-white);font-size:1rem;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:1;transition:all var(--t)}
.modal-close:hover{background:var(--c-red);border-color:var(--c-red)}
.modal-body{padding:1.75rem}
.modal-cat{font-size:.58rem;letter-spacing:.25em;text-transform:uppercase;color:var(--c-yellow);margin-bottom:.3rem}
.modal-name{font-family:var(--font-d);font-size:2rem;letter-spacing:.04em;line-height:.95;margin-bottom:.65rem}
.modal-desc{font-size:.83rem;color:var(--c-muted);line-height:1.75;margin-bottom:1.35rem}
.modal-ingred{background:var(--c-black);border-radius:var(--r);padding:.9rem 1rem;margin-bottom:1.25rem}
.modal-ingred-title{font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--c-yellow);margin-bottom:.5rem;font-weight:600}
.modal-ingred-list{font-size:.78rem;color:var(--c-muted);line-height:1.7}
.modal-tags{display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:1.5rem}
.modal-tag{font-size:.58rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:.2rem .6rem;border-radius:2px}
.modal-price-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,.07)}
.modal-price-wrap{display:flex;flex-direction:column}
.modal-price{font-family:var(--font-d);font-size:2.5rem;color:var(--c-yellow);line-height:1}
.modal-price-alt{font-size:.65rem;color:var(--c-muted);margin-top:.15rem}
.modal-qty{display:flex;align-items:center;gap:.75rem}
.qty-ctrl{width:34px;height:34px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:var(--r);color:var(--c-white);font-size:1rem;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all var(--t)}
.qty-ctrl:hover{background:var(--c-yellow);border-color:var(--c-yellow);color:var(--c-black)}
.modal-qty-num{font-family:var(--font-d);font-size:1.5rem;min-width:28px;text-align:center}
.modal-actions{display:flex;flex-direction:column;gap:.65rem}
.btn-add-cart{background:var(--c-yellow);color:var(--c-black);border:none;padding:1rem;font-family:var(--font-b);font-size:.8rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;border-radius:var(--r);cursor:pointer;transition:all var(--t);width:100%}
.btn-add-cart:hover{background:var(--c-white)}
.modal-btns-row{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}
.modal-pairing{background:rgba(27,67,50,.25);border:1px solid rgba(27,67,50,.5);border-radius:var(--r);padding:.75rem;margin-top:1rem}
.modal-pairing-title{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--c-green);margin-bottom:.25rem;font-weight:600}
.modal-pairing-text{font-size:.75rem;color:var(--c-muted)}
.modal-related{padding-top:1.25rem;border-top:1px solid rgba(255,255,255,.06);margin-top:1rem}
.modal-related-title{font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--c-muted);margin-bottom:.85rem;font-weight:600}
.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem}
.related-item{background:var(--c-black);border:1px solid rgba(255,255,255,.05);border-radius:var(--r);padding:.65rem .5rem;text-align:center;cursor:pointer;transition:all var(--t)}
.related-item:hover{border-color:rgba(245,196,0,.2);transform:translateY(-2px)}
.related-emoji{font-size:1.5rem;margin-bottom:.25rem}
.related-name{font-size:.62rem;color:var(--c-white);line-height:1.3}
.related-price{font-size:.68rem;color:var(--c-yellow);margin-top:.2rem;font-weight:700}

/* ─── RESERVATION MODAL ─── */
.res-modal-box{max-width:500px}

/* ─── TOAST ─── */
.toast{position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%) translateY(90px);background:var(--c-green);color:#fff;padding:.7rem 2rem;border-radius:var(--r);font-size:.75rem;font-weight:700;letter-spacing:.05em;z-index:9999;transition:transform var(--t);pointer-events:none;white-space:nowrap;box-shadow:0 4px 16px rgba(0,0,0,.4)}
.toast.show{transform:translateX(-50%) translateY(0)}
.toast.error{background:var(--c-red)}
.toast.warning{background:#B8791A}

/* ─── WA FLOAT ─── */
.wa-float{position:fixed;bottom:1.5rem;right:1.5rem;z-index:888;width:56px;height:56px;background:var(--c-wa);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;text-decoration:none;box-shadow:0 4px 20px rgba(37,211,102,.4);transition:all var(--t);animation:pulseWa 3s ease-in-out infinite}
.wa-float:hover{transform:scale(1.1);box-shadow:0 6px 30px rgba(37,211,102,.55)}

/* ─── ANIMATIONS ─── */
@keyframes fadeDown{from{opacity:0;transform:translateY(-18px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
@keyframes gradShift{0%{background-position:0% 50%}100%{background-position:200% 50%}}
@keyframes pulseWa{0%,100%{box-shadow:0 4px 20px rgba(37,211,102,.4)}50%{box-shadow:0 4px 36px rgba(37,211,102,.65)}}
@keyframes spin{to{transform:rotate(360deg)}}

/* ─── RESPONSIVE ─── */
@media(max-width:640px){
  .hero-ctas .btn-lg{padding:.8rem 1.5rem;font-size:.7rem}
  .fg-row{grid-template-columns:1fr}
  .delivery-btns-grid{grid-template-columns:1fr}
  .values-grid{grid-template-columns:1fr}
  .nl-form{flex-direction:column}
  .nl-input{min-width:unset}
  .modal-box{max-height:96dvh}
  .modal-btns-row{grid-template-columns:1fr}
  .related-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:400px){
  .hero-title{font-size:clamp(3.5rem,16vw,5rem)}
}
</style>

<body>

<!-- ═══ PROMO STRIP ═══ -->
<div id="promoStrip"></div>

<!-- ═══ NAVBAR ═══ -->
<nav id="nav" role="navigation" aria-label="Navegación principal">
  <a href="#" class="nav-brand" aria-label="Mecharon de Casa - Inicio">
    <span class="nav-brand-name">MECHARON DE CASA</span>
    <span class="nav-brand-sub">· Restobar · Est. 2018</span>
  </a>
  <ul class="nav-links" role="list">
    <li><a href="#carta">Menú</a></li>
